# Copy to .env and fill in. .env holds real secrets: never commit it, never paste it
# anywhere. Generate random values with:   openssl rand -base64 48
# (Comments must stay on their own lines - not after a value.)

# ---------- Site ----------
# The domain the ticket site is served on (no https://).
DOMAIN=passes.example.com
# http  = plain HTTP (local testing, and the first boot on the server)
# https = after the certificate has been issued (see DEPLOY.md, step 6)
NGINX_MODE=http
# Leave empty until HTTPS is set up, then set to: https   (starts the certbot renewer)
COMPOSE_PROFILES=
# Email Let's Encrypt uses for certificate-expiry warnings.
CERTBOT_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Database ----------
DB_NAME=otg
DB_USER=otg
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_PASSWORD=change-me

# ---------- Backend ----------
# Must match the address the site is opened at, exactly (scheme + domain, no trailing slash).
CORS_ALLOWED_ORIGINS=https://passes.example.com
# 48+ random bytes. Changing it later logs every user out.
JWT_SECRET_KEY=change-me
# Gmail address + a Gmail app password created only for production.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=change-me
# Comma-separated gate-staff emails. Empty = nobody can log in as a scanner.
SCANNER_MAIL=
# Test keys (rzp_test_...) first; live keys (rzp_live_...) only after the end-to-end test.
RAZORPAY_KEY_ID=rzp_test_change-me
RAZORPAY_KEY_SECRET=change-me
# The secret you type into the webhook form in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=change-me

# ---------- Memory limits (defaults suit a 2 GB instance) ----------
BACKEND_MEM=768m
POSTGRES_MEM=384m
REDIS_MEM=128m
NGINX_MEM=64m
